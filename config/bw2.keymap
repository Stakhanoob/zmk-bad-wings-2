#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define NAV_L 1
#define OTHER_L 2
#define NUM_L 3
#define SYM_L 4

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
//&lt { quick-tap-ms = <200>; };

&sk {
    quick-release;
    release-after-ms = <500>;
};

/ {
    behaviors {
        //#ifndef HOMEY_HOLDING_TYPE
        //#define HOMEY_HOLDING_TYPE "balanced"
        //#endif
        //#ifndef HOMEY_HOLDING_TIME
        //#define HOMEY_HOLDING_TIME 270
        //#endif
        //#ifndef HOMEY_STREAK_DECAY
        //#define HOMEY_STREAK_DECAY 170
        //#endif
        //#ifndef HOMEY_REPEAT_DECAY
        //#define HOMEY_REPEAT_DECAY 300 // "tap then hold" for key auto-repeat
        //#endif

        tapmod_thumb: miryoku_tapmod_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_MOD_THUMB";
            flavor = "hold-preferred";
            hold-trigger-on-release; // wait for other home row mods
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;

            //require-prior-idle-ms = <170>;

            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            //retro-tap;
        };

        layer_thumb: miryoku_home_row_layer_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_LAYER_THUMB";
            flavor = "tap-preferred";
            hold-trigger-on-release; // wait for other home row mods
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;

            //require-prior-idle-ms = <170>;

            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            //retro-tap;
        };

        hrm_auriculaire: hrm_auriculaire {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_AURICULAIRE";
        };

        hrm_annulaire: hrm_annulaire {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_ANNULAIRE";
        };

        hrm_majeur: hrm_majeur {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_MAJEUR";
        };

        hrm_index: hrm_index {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "HRM_INDEX";
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <160>;
            label = "HRM";
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <275>;
            quick-tap-ms = <250>;
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            label = "NEW_BEHAVIOR";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                    &kp W                       &hrm_majeur LEFT_ALT E  &kp R                    &kp T                 &kp Y                   &kp U                           &hrm_majeur LEFT_ALT I  &kp O                       &kp P
&hrm_auriculaire LGUI A  &hrm_annulaire RIGHT_ALT S  &hrm_majeur LCTRL D     &hrm_index LEFT_SHIFT F  &kp G                 &kp H                   &hrm_index LEFT_SHIFT J         &hrm_majeur LCTRL K     &hrm_annulaire RIGHT_ALT L  &hrm_auriculaire LGUI SEMI
&kp Z                    &kp X                       &kp C                   &kp V                    &kp B                 &kp N                   &kp M                           &kp COMMA               &kp DOT                     &kp FSLH
                                                     &kp LCTRL               &layer_thumb 1 SPACE     &layer_thumb 2 ENTER  &tapmod_thumb RALT TAB  &tapmod_thumb LSHIFT BACKSPACE  &kp LGUI
            >;
        };

        arrow_and_num {
            bindings = <
&kp PRINTSCREEN  &kp HOME      &kp UP            &kp END        &kp TAB          &kp KP_PLUS    &kp N4  &kp N5   &kp N6  &kp KP_ASTERISK
&kp LSHIFT       &kp LEFT      &kp DOWN          &kp RIGHT      &kp PRINTSCREEN  &kp KP_MINUS   &kp N1  &kp N2   &kp N3  &kp KP_DIVIDE
&kp LCTRL        &kp LG(LEFT)  &kp LG(UP_ARROW)  &kp LG(RIGHT)  &kp LC(LG(D))    &kp KP_DOT     &kp N7  &kp N8   &kp N9  &kp KP_NUMLOCK
                               &trans            &trans         &trans           &kp BACKSPACE  &kp N0  &kp TAB
            >;
        };

        Fx_and_Co {
            bindings = <
&kp LC(LA(DELETE))  &kp LALT   &kp LSHIFT   &kp DEL      &kp BACKSPACE  &kp C_VOL_UP       &kp F1  &kp F2   &kp F3   &kp F4
&caps_word          &kp ESC    &kp LCTRL    &kp TAB      &kp ENTER      &kp C_VOLUME_DOWN  &kp F5  &kp F6   &kp F7   &kp F8
&kp LC(LA(K))       &kp LC(X)  &kp LC(INS)  &kp LS(INS)  &kp LG(V)      &kp C_MUTE         &kp F9  &kp F10  &kp F11  &kp F12
                               &trans       &trans       &trans         &trans             &trans  &trans
            >;
        };
    };
};
